@model MobilePriceWeb.Models.PredictionViewModel

@{
    ViewData["Title"] = "Phone Price Prediction";
}

<style>
    body {
        background: #0f172a;
        color: #e2e8f0;
    }

    .prediction-page {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    .hero {
        text-align: center;
        margin-bottom: 35px;
    }

    .hero h1 {
        font-size: 42px;
        font-weight: 800;
        background: linear-gradient(90deg, #38bdf8, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero p {
        color: #94a3b8;
        font-size: 17px;
    }

    .prediction-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }

    .section-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 22px;
        color: #f8fafc;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #475569;
        border-radius: 12px;
        padding: 12px;
    }

    .form-control:focus {
        background: #0f172a;
        color: white;
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
    }

    .predict-btn {
        background: linear-gradient(90deg, #2563eb, #7c3aed);
        border: none;
        border-radius: 14px;
        padding: 16px;
        color: white;
        font-size: 18px;
        font-weight: 700;
        transition: 0.2s;
    }

    .predict-btn:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    .result-card {
        margin-top: 30px;
        padding: 25px;
        border-radius: 18px;
        background: linear-gradient(135deg, #064e3b, #065f46);
        border: 1px solid #10b981;
        text-align: center;
    }

    .result-card h2 {
        color: #6ee7b7;
        font-size: 26px;
        font-weight: 800;
    }

    .info-card {
        margin-top: 20px;
        padding: 20px;
        border-radius: 16px;
        background: #172033;
        border: 1px solid #334155;
        color: #94a3b8;
    }
</style>

<div class="prediction-page">

    <div class="hero">
        <h1>📱 Phone Price AI</h1>
        <p>Smartphone price category prediction using Machine Learning</p>
    </div>

    <div class="prediction-card">

        <div class="section-title">
            ⚙️ Smartphone Specifications
        </div>

        <form asp-action="Index" method="post">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">

                @foreach (var property in new[]
                                {
                                ("Battery_power", "Battery Power"),
                                ("Blue", "Bluetooth (0 or 1)"),
                                ("Clock_speed", "Clock Speed"),
                                ("Dual_sim", "Dual SIM (0 or 1)"),
                                ("Fc", "Front Camera"),
                                ("Four_g", "4G (0 or 1)"),
                                ("Int_memory", "Internal Memory"),
                                ("M_dep", "Mobile Depth"),
                                ("Mobile_wt", "Mobile Weight"),
                                ("N_cores", "Number of Cores"),
                                ("Pc", "Primary Camera"),
                                ("Px_height", "Pixel Height"),
                                ("Px_width", "Pixel Width"),
                                ("Ram", "RAM"),
                                ("Sc_h", "Screen Height"),
                                ("Sc_w", "Screen Width"),
                                ("Talk_time", "Talk Time"),
                                ("Three_g", "3G (0 or 1)"),
                                ("Touch_screen", "Touch Screen (0 or 1)"),
                                ("Wifi", "WiFi (0 or 1)")
                                })
                {
                    <div class="col-md-6 mb-4">

                        <label class="form-label">
                            @property.Item2
                        </label>

                        <input type="number"
                               step="any"
                               name="@property.Item1"
                               value="@(ViewData.ModelState[property.Item1]?.AttemptedValue ?? "")"
                               class="form-control"
                               required />

                    </div>
                }

            </div>

            <button type="submit" class="btn predict-btn w-100 mt-3">
                🔮 Predict Price Category
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model?.Result))
        {
            <div class="result-card">
                <h2>🎯 Prediction Result</h2>
                <p class="fs-5 mb-0">@Model.Result</p>
            </div>
        }

    </div>

    <div class="info-card text-center">
        🤖 Model trained with ML.NET AutoML
        <br />
        📊 Dataset: Mobile Price Classification (Kaggle)
        <br />
        ⭐ Accuracy: 95%
    </div>

</div>